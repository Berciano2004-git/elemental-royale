# Clave de API de Archil (https://archil.com) para el historial persistente de
# partidas. Sin ella el juego funciona igual, pero no se guarda nada en disco.
ARCHIL_API_KEY=

# Región del disco: aws-us-east-1 | aws-us-west-2 | aws-eu-west-1 | gcp-us-central1
ARCHIL_REGION=aws-us-east-1

# Nombre del disco; se crea la primera vez que se guarda una partida.
ARCHIL_DISK=elemental-royale
